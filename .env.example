INSTANCE_CONNECTION_NAME=project:region:instance
DB_USER=app_user
# Choose one password source:
# DB_PASSWORD=replace-me
DB_PASSWORD_SECRET=projects/your-project/secrets/db-password/versions/latest
# If DB_PASSWORD_SECRET is a bare secret id, set GCP_PROJECT_ID too:
# GCP_PROJECT_ID=your-project
DB_NAME=app_db
DB_PORT=3306
TABLE_NAME=partition_test
PARTITION_COLUMN=created_at
TIMEZONE=Asia/Taipei
PARTITION_SPAN_DAYS=1
CREATE_AHEAD_DAYS=30
DROP_BEFORE_DAYS=90
MAX_CREATE_PARTITIONS_PER_RUN=30
MAX_DROP_PARTITIONS_PER_RUN=30
MAX_REPAIR_PARTITIONS_PER_RUN=50
AUTO_REPAIR_FORWARD_GAPS=false
PARTITION_LOCK_NAME=partition-maintainer:partition_test
LOCK_TIMEOUT_SECONDS=10
DRY_RUN=true
